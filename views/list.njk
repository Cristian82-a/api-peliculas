{% extends "layout.njk" %}

{% block content %}
  <p><a href="/web/movies/new">+ Añadir película</a></p>

  {% if movies.length == 0 %}
    <p>No hay películas.</p>
  {% else %}
    <table>
      <tr><th>Favorita</th><th>Título</th><th>Año</th><th>Director</th><th>Acciones</th></tr> aqui
      {% for movie in movies %}
        <tr>
          <td>
            <form method="post" action="/web/movies/{{ movie.id }}/favorite" style="display:inline">
              <button type="submit" title="Favorita"
                      style="background:none;border:none;font-size:1.6em;cursor:pointer;color:gold">
                {% if movie.favorite %}★{% else %}☆{% endif %}
              </button>
            </form>
          </td>
          <td>{{ movie.title }}</td>
          <td>{{ movie.year }}</td>
          <td>{{ movie.director }}</td>
          <td class="acciones">
            <a href="/web/movies/{{ movie.id }}">Ver</a> |
            <a href="/web/movies/{{ movie.id }}/edit">Editar</a> |
            <form method="post" action="/web/movies/{{ movie.id }}/delete"
                  onsubmit="return confirm('¿Eliminar esta película?')">
              <button type="submit">Eliminar</button>
            </form>
          </td>
        </tr>
      {% endfor %}
    </table>
  {% endif %}
{% endblock %}